{
  "expo": {
    "name": "Zipschool OS",
    "slug": "zipschool-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zipschool.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zipschool OS to access your photos for profile pictures and documents.",
          "cameraPermission": "Allow Zipschool OS to use the camera to take photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Zipschool OS to use your location when you update a bus position."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b62b5fb7-43db-445b-be7a-727dc40d61fe"
      }
    },
    "owner": "ai-knots-it-solution"
  }
}
